Private Function SetCutFeatureScopeToCurrentGearBody(ByVal swCutFeat As SldWorks.Feature, _
    Optional ByVal swTargetBody As SldWorks.Body2 = Nothing) As Boolean

    Dim swDef As Object
    Dim swBody As SldWorks.Body2
    Dim bodyArr(0) As Object
    Dim vBodies As Variant
    Dim bodyLabel As String

    SetCutFeatureScopeToCurrentGearBody = False
    If swCutFeat Is Nothing Then Exit Function
    Set swBody = swTargetBody
    If swBody Is Nothing Then Set swBody = NameAndResolveCurrentGearSolidBody("cut scope")
    If swBody Is Nothing Then Exit Function
    bodyLabel = Trim$(swBody.name)

    On Error Resume Next
    Set swDef = swCutFeat.GetDefinition
    If swDef Is Nothing Then Exit Function
    If Not swDef.AccessSelections(swPart, Nothing) Then Exit Function
    swDef.FeatureScope = True
    swDef.AutoSelect = False
    bodyArr(0) = swBody
    vBodies = bodyArr
    swDef.FeatureScopeBodies = vBodies
    If Err.Number <> 0 Then
        Err.Clear
        swDef.Bodies = vBodies
    End If
    SetCutFeatureScopeToCurrentGearBody = swCutFeat.ModifyDefinition(swDef, swPart, Nothing)
    swDef.ReleaseSelectionAccess
    If SetCutFeatureScopeToCurrentGearBody Then
        DebugPrint "SetCutFeatureScopeToCurrentGearBody OK body=""" & bodyLabel & """"
    Else
        DebugPrint "SetCutFeatureScopeToCurrentGearBody failed body=""" & bodyLabel & """: " & Err.Number & " " & Err.Description
        Err.Clear
    End If
    On Error GoTo 0
End Function

Private Function TryCreateGapCutFeature(ByRef methodUsed As String, ByVal swTargetBody As SldWorks.Body2) As SldWorks.Feature
    Dim skName As String
    Dim bodyName As String
    Dim useScope As Boolean

    Set TryCreateGapCutFeature = Nothing
    methodUsed = ""
    useScope = PartNeedsCutFeatureScope()

    skName = GetGapSketchFeatName()
    If skName = "" And Not swToothGapSketchFeat Is Nothing Then skName = swToothGapSketchFeat.Name
    If skName = "" Then skName = BuildGearPrefixName() & "_Gap"

    bodyName = BuildGearBodyName()
    If Not swTargetBody Is Nothing Then
        If Trim$(swTargetBody.name) <> "" Then bodyName = Trim$(swTargetBody.name)
    End If

    DebugPrint "TryCreateGapCutFeature: scoped=" & useScope & " sketch=""" & skName & """ body=""" & bodyName & """"

    If Not SelectGapSketchAndBodyByNameForCut(skName, bodyName, useScope) Then
        NoteGearBuildError "TryCreateGapCutFeature: SelectByID2 failed sketch=""" & skName & """ body=""" & bodyName & """"
        Exit Function
    End If

    If useScope Then
        Set TryCreateGapCutFeature = FeatureCut4RecordedScoped()
        methodUsed = "FeatureCut4 recorded (Sd=False T1=9 T2=1 featScope=True autoSelect=False)"
    Else
        Set TryCreateGapCutFeature = FeatureCut4RecordedSingleBody()
        methodUsed = "FeatureCut4 recorded single-body (autoSelect=True)"
    End If

    If TryCreateGapCutFeature Is Nothing Then
        NoteGearBuildError "TryCreateGapCutFeature: FeatureCut4 returned Nothing"
    End If
End Function

Public Function CutExtrudeToothGap() As Boolean
    On Error GoTo CutFail
    Dim methodUsed As String
    Dim swTargetBody As SldWorks.Body2

    ClearLastGearBuildError
    DebugPrint "CutExtrudeToothGap: begin depth=" & Format(GearGeom.RimWidthMM, "0.###") & " mm"
    If swToothGapSketchFeat Is Nothing Then Set swToothGapSketchFeat = FindLastSketchFeature()
    If swToothGapSketchFeat Is Nothing Then
        NoteGearBuildError "CutExtrudeToothGap: no gap sketch feature"
        DebugPrint gLastGearBuildError
        GoTo CutFail
    End If

    RebuildSWPart
    ExitActiveSketchIfAny
    Set swTargetBody = NameAndResolveCurrentGearSolidBody("before cut")
    If swTargetBody Is Nothing Then
        NoteGearBuildError "CutExtrudeToothGap: could not name/resolve gear solid body before cut"
        GoTo CutFail
    End If

    Set swToothCutFeat = TryCreateGapCutFeature(methodUsed, swTargetBody)
    If swToothCutFeat Is Nothing Then
        If gLastGearBuildError = "" Then NoteGearBuildError "CutExtrudeToothGap: TryCreateGapCutFeature returned Nothing"
        GoTo CutFail
    End If

    Set swTargetBody = NameAndResolveCurrentGearSolidBody("after cut")

    DebugPrint "Tooth gap cut feature: " & swToothCutFeat.name & " (" & methodUsed & _
        IIf(PartNeedsCutFeatureScope(), ", scoped to """ & Trim$(swTargetBody.name) & """)", ")")
    ClearSWSelection
    RebuildSWPart
    ClearLastGearBuildError
    DebugPrint "CutExtrudeToothGap OK"
    CutExtrudeToothGap = True
    Exit Function

CutFail:
    NoteGearBuildError FormatVBError("CutExtrudeToothGap")
    If gLastGearBuildError = "" Then NoteGearBuildError "CutExtrudeToothGap failed (sketch select or FeatureCut4)"
    DebugPrint "CutExtrudeToothGap FAIL: " & gLastGearBuildError
    CutExtrudeToothGap = False
End Function
