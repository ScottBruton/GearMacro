Option Explicit

' =============================================================================
' FEATURE: Tooth — involute spline tooth-gap sketch + cut extrude
' =============================================================================
' One tooth-gap profile from parametric involute math (form inputs -> GearGeom):
'   - Two splines (flank A / flank B)
'   - Outer arc between spline OD ends
'   - Root arc (or root radial connectors + root arc when rf < rb)
' GenerateGear: CreateToothGapSketch -> CutExtrudeToothGap -> CircularPatternTooth
' =============================================================================

Private Const SW_END_BLIND As Long = 0
Private Const SW_END_THROUGH_ALL As Long = 1
Private Const INVOLUTE_SPLINE_POINT_COUNT As Long = 30

Private mGapSketchFeatName As String

Public Sub Tooth_ResetBuildRefs()
    Set swToothGapSketchFeat = Nothing
    Set swToothCutFeat = Nothing
    mGapSketchFeatName = ""
End Sub

Public Function GetGapSketchFeatName() As String
    GetGapSketchFeatName = mGapSketchFeatName
End Function

' Builds one closed tooth-gap profile from involute parameters (metres, radians).
Private Function DrawInvoluteToothGapSketch(ByVal cx As Double, ByVal cy As Double, _
    ByVal z As Long, ByVal pa As Double, ByVal rb As Double, ByVal ra As Double, ByVal rf As Double) As Boolean

    Dim toothAngle As Double
    Dim halfToothAngle As Double
    Dim invPA As Double
    Dim rotA As Double
    Dim rotB As Double
    Dim involuteStartRadius As Double
    Dim needsRootConnector As Boolean
    Dim tMin As Double
    Dim tMax As Double
    Dim ptsA() As Double
    Dim ptsB() As Double
    Dim i As Long
    Dim t As Double
    Dim x As Double
    Dim y As Double
    Dim xa As Double
    Dim ya As Double
    Dim xb As Double
    Dim yb As Double
    Dim aStartX As Double
    Dim aStartY As Double
    Dim bStartX As Double
    Dim bStartY As Double
    Dim aOuterX As Double
    Dim aOuterY As Double
    Dim bOuterX As Double
    Dim bOuterY As Double
    Dim angOuterA As Double
    Dim angOuterB As Double
    Dim angOuterMid As Double
    Dim xOuterMid As Double
    Dim yOuterMid As Double
    Dim angRootMid As Double
    Dim xRootMidArc As Double
    Dim yRootMidArc As Double
    Dim angA As Double
    Dim angB As Double
    Dim aRootX As Double
    Dim aRootY As Double
    Dim bRootX As Double
    Dim bRootY As Double
    Dim flankA As SldWorks.SketchSegment
    Dim flankB As SldWorks.SketchSegment
    Dim outerArc As SldWorks.SketchSegment
    Dim rootArc As SldWorks.SketchSegment
    Dim nPts As Long

    DrawInvoluteToothGapSketch = False
    If z < 3 Then Exit Function
    If rb <= 0# Or ra <= 0# Or rf <= 0# Then Exit Function
    If ra <= rb Then Exit Function

    toothAngle = 2# * Pi / CDbl(z)
    halfToothAngle = Pi / (2# * CDbl(z))
    invPA = Tan(pa) - pa
    rotA = halfToothAngle + invPA
    rotB = toothAngle - rotA

    If rf >= rb Then
        involuteStartRadius = rf
        needsRootConnector = False
    Else
        involuteStartRadius = rb
        needsRootConnector = True
    End If

    tMin = Sqr((involuteStartRadius / rb) ^ 2# - 1#)
    tMax = Sqr((ra / rb) ^ 2# - 1#)
    If tMax <= tMin Then Exit Function

    nPts = INVOLUTE_SPLINE_POINT_COUNT + 1
    ReDim ptsA(0 To (nPts * 3) - 1)
    ReDim ptsB(0 To (nPts * 3) - 1)

    For i = 0 To INVOLUTE_SPLINE_POINT_COUNT
        t = tMin + (CDbl(i) * (tMax - tMin) / CDbl(INVOLUTE_SPLINE_POINT_COUNT))
        If needsRootConnector Then
            ' tMin = 0 at base circle: negate t so mirrored flanks diverge with opposite curvature
            t = -t
        End If
        x = rb * (Cos(t) + t * Sin(t))
        y = rb * (Sin(t) - t * Cos(t))
        xa = x * Cos(rotA) - y * Sin(rotA)
        ya = x * Sin(rotA) + y * Cos(rotA)
        xb = x * Cos(rotB) + y * Sin(rotB)
        yb = x * Sin(rotB) - y * Cos(rotB)
        ptsA(i * 3 + 0) = cx + xa
        ptsA(i * 3 + 1) = cy + ya
        ptsA(i * 3 + 2) = 0#
        ptsB((INVOLUTE_SPLINE_POINT_COUNT - i) * 3 + 0) = cx + xb
        ptsB((INVOLUTE_SPLINE_POINT_COUNT - i) * 3 + 1) = cy + yb
        ptsB((INVOLUTE_SPLINE_POINT_COUNT - i) * 3 + 2) = 0#
    Next i

    On Error Resume Next
    Set flankA = swSketchManager.CreateSpline2((ptsA), False)
    Set flankB = swSketchManager.CreateSpline2((ptsB), False)
    If flankA Is Nothing Or flankB Is Nothing Then
        DebugPrint "DrawInvoluteToothGapSketch FAIL: CreateSpline2"
        Exit Function
    End If

    aStartX = ptsA(0)
    aStartY = ptsA(1)
    bStartX = ptsB((nPts * 3) - 3)
    bStartY = ptsB((nPts * 3) - 2)
    aOuterX = ptsA((INVOLUTE_SPLINE_POINT_COUNT) * 3 + 0)
    aOuterY = ptsA((INVOLUTE_SPLINE_POINT_COUNT) * 3 + 1)
    bOuterX = ptsB(0)
    bOuterY = ptsB(1)

    ' 3-point arc with midpoint on the short OD span (CreateArc direction flag wraps the long way).
    angOuterA = Atn2(aOuterY - cy, aOuterX - cx)
    angOuterB = Atn2(bOuterY - cy, bOuterX - cx)
    angOuterMid = (angOuterA + angOuterB) * 0.5#
    xOuterMid = cx + ra * Cos(angOuterMid)
    yOuterMid = cy + ra * Sin(angOuterMid)
    Set outerArc = swSketchManager.Create3PointArc(aOuterX, aOuterY, 0#, bOuterX, bOuterY, 0#, xOuterMid, yOuterMid, 0#)
    If outerArc Is Nothing Then
        DebugPrint "DrawInvoluteToothGapSketch FAIL: outer arc"
        Exit Function
    End If

    If Not needsRootConnector Then
        angRootMid = (Atn2(aStartY - cy, aStartX - cx) + Atn2(bStartY - cy, bStartX - cx)) * 0.5#
        xRootMidArc = cx + rf * Cos(angRootMid)
        yRootMidArc = cy + rf * Sin(angRootMid)
        Set rootArc = swSketchManager.Create3PointArc(bStartX, bStartY, 0#, aStartX, aStartY, 0#, xRootMidArc, yRootMidArc, 0#)
    Else
        angA = Atn2(aStartY - cy, aStartX - cx)
        angB = Atn2(bStartY - cy, bStartX - cx)
        aRootX = cx + rf * Cos(angA)
        aRootY = cy + rf * Sin(angA)
        bRootX = cx + rf * Cos(angB)
        bRootY = cy + rf * Sin(angB)
        swSketchManager.CreateLine aRootX, aRootY, 0#, aStartX, aStartY, 0#
        swSketchManager.CreateLine bStartX, bStartY, 0#, bRootX, bRootY, 0#
        angRootMid = (Atn2(aRootY - cy, aRootX - cx) + Atn2(bRootY - cy, bRootX - cx)) * 0.5#
        xRootMidArc = cx + rf * Cos(angRootMid)
        yRootMidArc = cy + rf * Sin(angRootMid)
        Set rootArc = swSketchManager.Create3PointArc(bRootX, bRootY, 0#, aRootX, aRootY, 0#, xRootMidArc, yRootMidArc, 0#)
    End If

    If rootArc Is Nothing Then
        DebugPrint "DrawInvoluteToothGapSketch FAIL: root arc"
        Exit Function
    End If

    DrawInvoluteToothGapSketch = True
    DebugPrint "DrawInvoluteToothGapSketch OK z=" & z & " rb=" & Format(rb * MM_PER_M, "0.###") & _
        " ra=" & Format(ra * MM_PER_M, "0.###") & " rf=" & Format(rf * MM_PER_M, "0.###") & " mm" & _
        IIf(needsRootConnector, " (root connectors)", "")
    On Error GoTo 0
End Function

Public Function CreateToothGapSketch() As Boolean
    On Error GoTo SketchFail

    Dim cx As Double
    Dim cy As Double
    Dim z As Long
    Dim pa As Double
    Dim rb As Double
    Dim ra As Double
    Dim rf As Double
    Dim gapSkName As String

    CreateToothGapSketch = False
    DebugPrint "CreateToothGapSketch: --- involute spline workflow ---"

    If GearGeom.IsInternal Then
        NoteGearBuildError "Involute spline tooth gap is not implemented for internal gears yet."
        GoTo SketchFail
    End If

    cx = gSketchOffsetXM
    cy = gSketchOffsetYM
    If GearTrainRole = GEAR_ROLE_DRIVING Then
        cx = 0#
        cy = 0#
    End If

    z = GearGeom.numTeeth
    pa = GearGeom.pressureAngleDeg * Pi / 180#
    rb = GearGeom.BaseRadiusM
    ra = GearGeom.AddendumRadiusM
    rf = GearGeom.DedendumRadiusM

    If z < 3 Then
        NoteGearBuildError "Tooth count must be >= 3."
        GoTo SketchFail
    End If
    If rf <= 0# Then
        NoteGearBuildError "Invalid root radius (dedendum extends past centre)."
        GoTo SketchFail
    End If

    If Not BeginSketchOnFrontPlane() Then GoTo SketchFail
    Set sw2DSketch = swSketchManager.ActiveSketch
    DebugPrint "CreateToothGapSketch: centre (mm)=(" & Format(cx * MM_PER_M, "0.###") & ", " & Format(cy * MM_PER_M, "0.###") & ")"

    If Not DrawInvoluteToothGapSketch(cx, cy, z, pa, rb, ra, rf) Then GoTo SketchFail

    swSketchManager.InsertSketch True
    Set swToothGapSketchFeat = FindLastSketchFeature()
    If swToothGapSketchFeat Is Nothing Then GoTo SketchFail

    gapSkName = BuildGearPrefixName() & "_Gap"
    RenameSketchFeatureSafe swToothGapSketchFeat, gapSkName
    mGapSketchFeatName = swToothGapSketchFeat.name
    gGapSketchFeatName = mGapSketchFeatName

    ClearSWSelection
    RebuildSWPart
    DebugPrint "CreateToothGapSketch OK feat=" & mGapSketchFeatName & " z=" & z & " m=" & GearGeom.moduleMM
    CreateToothGapSketch = True
    Exit Function

SketchFail:
    NoteGearBuildError FormatVBError("CreateToothGapSketch")
    If gLastGearBuildError = "" Then NoteGearBuildError "CreateToothGapSketch failed (involute spline sketch)"
    DebugPrint "CreateToothGapSketch FAIL: " & gLastGearBuildError
    CreateToothGapSketch = False
End Function

' ---------------------------------------------------------------------------
' Cut extrude (blind through rim width, then through-all fallback)
' ---------------------------------------------------------------------------

Public Function FindLastCutExtrudeFeature() As SldWorks.Feature
    Dim ft As SldWorks.Feature
    Dim lastCut As SldWorks.Feature
    Dim tn As String

    Set ft = swPart.FirstFeature
    Do While Not ft Is Nothing
        tn = ft.GetTypeName2
        If (tn = "CutExtrude") Or (Left$(ft.name, 4) = "Cut-") Then Set lastCut = ft
        Set ft = ft.GetNextFeature
    Loop
    Set FindLastCutExtrudeFeature = lastCut
End Function

Private Function SelectGapSketchForCut() As Boolean
    Dim skName As String
    Dim docTitle As String

    SelectGapSketchForCut = False
    If swToothGapSketchFeat Is Nothing Then Set swToothGapSketchFeat = FindLastSketchFeature()
    If swToothGapSketchFeat Is Nothing Then Exit Function

    ClearSWSelection
    skName = swToothGapSketchFeat.name
    On Error Resume Next
    swToothGapSketchFeat.Select2 False, 0
    If swSelMgr.GetSelectedObjectCount2(-1) >= 1 Then
        SelectGapSketchForCut = True
        Exit Function
    End If
    docTitle = swDoc.GetTitle
    If docTitle <> "" Then
        SelectGapSketchForCut = swModelDocExt.SelectByID2(skName & "@" & docTitle, "SKETCH", 0, 0, 0, False, 0, Nothing, 0)
    End If
    If Not SelectGapSketchForCut Then
        SelectGapSketchForCut = swModelDocExt.SelectByID2(skName, "SKETCH", 0, 0, 0, False, 0, Nothing, 0)
    End If
    On Error GoTo 0
End Function

Private Function SelectGapSketchForCutAppend() As Boolean
    Dim skName As String
    Dim docTitle As String

    SelectGapSketchForCutAppend = False
    If swToothGapSketchFeat Is Nothing Then Exit Function
    skName = swToothGapSketchFeat.name
    On Error Resume Next
    swToothGapSketchFeat.Select2 True, 0
    If swSelMgr.GetSelectedObjectCount2(-1) >= 1 Then
        SelectGapSketchForCutAppend = True
        Exit Function
    End If
    docTitle = swDoc.GetTitle
    If docTitle <> "" Then
        SelectGapSketchForCutAppend = swModelDocExt.SelectByID2(skName & "@" & docTitle, "SKETCH", 0#, 0#, 0#, True, 0, Nothing, 0)
    End If
    If Not SelectGapSketchForCutAppend Then
        SelectGapSketchForCutAppend = swModelDocExt.SelectByID2(skName, "SKETCH", 0#, 0#, 0#, True, 0, Nothing, 0)
    End If
    On Error GoTo 0
End Function

Private Function SelectCurrentGearBodyForCutScope() As Boolean
    Dim swBody As SldWorks.Body2

    SelectCurrentGearBodyForCutScope = False
    Set swBody = GetCurrentGearSolidBody()
    If swBody Is Nothing Then Exit Function

    SelectCurrentGearBodyForCutScope = SelectSolidBodyWithMark(swBody, True, 8)
    If SelectCurrentGearBodyForCutScope Then
        DebugPrint "SelectCurrentGearBodyForCutScope OK: " & Trim$(swBody.name)
    End If
End Function

Private Function SetCutFeatureScopeToCurrentGearBody(ByVal swCutFeat As SldWorks.Feature) As Boolean
    Dim swDef As Object
    Dim swBody As SldWorks.Body2
    Dim bodyArr(0) As Object
    Dim vBodies As Variant

    SetCutFeatureScopeToCurrentGearBody = False
    If swCutFeat Is Nothing Then Exit Function
    Set swBody = GetCurrentGearSolidBody()
    If swBody Is Nothing Then Exit Function

    On Error Resume Next
    Set swDef = swCutFeat.GetDefinition
    If swDef Is Nothing Then Exit Function
    If Not swDef.AccessSelections(swPart, Nothing) Then Exit Function
    swDef.FeatureScope = True
    swDef.AutoSelect = False
    bodyArr(0) = swBody
    vBodies = bodyArr
    swDef.FeatureScopeBodies = vBodies
    If Err.Number <> 0 Then
        Err.Clear
        swDef.Bodies = vBodies
    End If
    SetCutFeatureScopeToCurrentGearBody = swCutFeat.ModifyDefinition(swDef, swPart, Nothing)
    swDef.ReleaseSelectionAccess
    If SetCutFeatureScopeToCurrentGearBody Then
        DebugPrint "SetCutFeatureScopeToCurrentGearBody OK"
    Else
        DebugPrint "SetCutFeatureScopeToCurrentGearBody failed: " & Err.Number & " " & Err.Description
        Err.Clear
    End If
    On Error GoTo 0
End Function

Private Function TryCreateGapCutFeature(ByRef methodUsed As String) As SldWorks.Feature
    Dim lastErr As Long
    Dim lastDesc As String
    Dim useScope As Boolean
    Dim useFeatScope As Boolean
    Dim useAutoSelect As Boolean
    Dim startCond As Long
    Dim startOff As Double

    Set TryCreateGapCutFeature = Nothing
    methodUsed = ""
    useScope = PartNeedsCutFeatureScope()
    useFeatScope = useScope
    useAutoSelect = Not useScope
    GetGearExtrudeStartParams startCond, startOff
    On Error Resume Next

    Err.Clear
    Set TryCreateGapCutFeature = swFeatMgr.FeatureCut4( _
        True, False, False, _
        SW_END_BLIND, SW_END_BLIND, GearGeom.RimWidthM, 0#, _
        False, False, False, False, _
        0#, 0#, _
        False, False, False, False, _
        False, _
        useFeatScope, useAutoSelect, _
        False, False, False, _
        startCond, startOff, False, False)
    If Not TryCreateGapCutFeature Is Nothing Then
        methodUsed = "FeatureCut4 Blind rim width"
        Exit Function
    End If
    lastErr = Err.Number: lastDesc = Err.Description: Err.Clear

    Set TryCreateGapCutFeature = swFeatMgr.FeatureCut4( _
        True, False, False, _
        SW_END_THROUGH_ALL, SW_END_BLIND, 0#, 0#, _
        False, False, False, False, _
        0#, 0#, _
        False, False, False, False, _
        False, _
        useFeatScope, useAutoSelect, _
        False, False, False, _
        startCond, startOff, False, False)
    If Not TryCreateGapCutFeature Is Nothing Then
        methodUsed = "FeatureCut4 Through all"
        Exit Function
    End If
    lastErr = Err.Number: lastDesc = Err.Description: Err.Clear

    Set TryCreateGapCutFeature = swFeatMgr.FeatureCut4( _
        True, False, False, _
        SW_END_BLIND, SW_END_BLIND, GearGeom.WidthM, 0#, _
        False, False, False, False, _
        0#, 0#, _
        False, False, False, False, _
        False, _
        useFeatScope, useAutoSelect, _
        False, False, False, _
        startCond, startOff, False, False)
    If Not TryCreateGapCutFeature Is Nothing Then
        methodUsed = "FeatureCut4 Blind full width"
        Exit Function
    End If

    If gLastGearBuildError = "" Then
        NoteGearBuildError "TryCreateGapCutFeature failed: " & lastErr & " " & lastDesc
    End If
    On Error GoTo 0
End Function

Public Function CutExtrudeToothGap() As Boolean
    On Error GoTo CutFail
    Dim methodUsed As String
    Dim selCount As Long

    DebugPrint "CutExtrudeToothGap: begin depth=" & Format(GearGeom.RimWidthMM, "0.###") & " mm"
    If swToothGapSketchFeat Is Nothing Then Set swToothGapSketchFeat = FindLastSketchFeature()
    If swToothGapSketchFeat Is Nothing Then
        NoteGearBuildError "CutExtrudeToothGap: no gap sketch feature"
        DebugPrint gLastGearBuildError
        GoTo CutFail
    End If

    RebuildSWPart
    ExitActiveSketchIfAny
    If Not SelectGapSketchForCut() Then
        NoteGearBuildError "CutExtrudeToothGap: sketch select failed (" & swToothGapSketchFeat.name & ")"
        DebugPrint gLastGearBuildError
        GoTo CutFail
    End If

    If PartNeedsCutFeatureScope() Then
        If SelectCurrentGearBodyForCutScope() Then
            If Not SelectGapSketchForCutAppend() Then
                DebugPrint "CutExtrudeToothGap: warning — could not re-select sketch after body scope"
            End If
        Else
            DebugPrint "CutExtrudeToothGap: warning — could not pre-select body for feature scope"
        End If
    End If

    selCount = swSelMgr.GetSelectedObjectCount2(-1)
    DebugPrint "CutExtrudeToothGap: selections before cut, count=" & selCount

    Set swToothCutFeat = TryCreateGapCutFeature(methodUsed)
    If swToothCutFeat Is Nothing Then
        If gLastGearBuildError = "" Then NoteGearBuildError "CutExtrudeToothGap: TryCreateGapCutFeature returned Nothing"
        GoTo CutFail
    End If

    If PartNeedsCutFeatureScope() Then
        SetCutFeatureScopeToCurrentGearBody swToothCutFeat
    End If

    DebugPrint "Tooth gap cut feature: " & swToothCutFeat.name & " (" & methodUsed & _
        IIf(PartNeedsCutFeatureScope(), ", scoped to current gear body)", ")")
    ClearSWSelection
    RebuildSWPart
    DebugPrint "CutExtrudeToothGap OK"
    CutExtrudeToothGap = True
    Exit Function

CutFail:
    NoteGearBuildError FormatVBError("CutExtrudeToothGap")
    If gLastGearBuildError = "" Then NoteGearBuildError "CutExtrudeToothGap failed (sketch select or FeatureCut4)"
    DebugPrint "CutExtrudeToothGap FAIL: " & gLastGearBuildError
    CutExtrudeToothGap = False
End Function
