' SelectByID2 returns Boolean but can arrive as Integer via COM — never use "If Not ok" on the raw value.
Private Function SelectByID2Ok(ByVal result As Variant) As Boolean
    On Error Resume Next
    SelectByID2Ok = False
    If IsEmpty(result) Then Exit Function
    If VarType(result) = vbBoolean Then
        SelectByID2Ok = result
    Else
        SelectByID2Ok = (CLng(result) <> 0)
    End If
    On Error GoTo 0
End Function

' Select gap sketch then target solid by feature/body name — matches recorded macro.
Private Function SelectGapSketchAndBodyByNameForCut(ByVal skName As String, ByVal bodyName As String, ByVal scoped As Boolean) As Boolean
    Dim docTitle As String
    Dim selOk As Boolean

    SelectGapSketchAndBodyByNameForCut = False
    ClearSWSelection
    Err.Clear

    selOk = SelectByID2Ok(swModelDocExt.SelectByID2(skName, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, 0))
    If selOk = False Then
        docTitle = swDoc.GetTitle
        If docTitle <> "" Then
            selOk = SelectByID2Ok(swModelDocExt.SelectByID2(skName & "@" & docTitle, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, 0))
        End If
    End If
    If selOk = False Then
        DebugPrint "SelectGapSketchAndBodyByNameForCut: sketch FAIL """ & skName & """ err=" & Err.Number
        Exit Function
    End If
    DebugPrint "SelectGapSketchAndBodyByNameForCut: sketch OK """ & skName & """"

    If scoped Then
        selOk = SelectByID2Ok(swModelDocExt.SelectByID2(bodyName, "SOLIDBODY", 0#, 0#, 0#, True, 8, Nothing, 0))
        If selOk = False Then
            docTitle = swDoc.GetTitle
            If docTitle <> "" Then
                selOk = SelectByID2Ok(swModelDocExt.SelectByID2(bodyName & "@" & docTitle, "SOLIDBODY", 0#, 0#, 0#, True, 8, Nothing, 0))
            End If
        End If
        If selOk = False Then
            DebugPrint "SelectGapSketchAndBodyByNameForCut: body FAIL """ & bodyName & """ err=" & Err.Number
            Exit Function
        End If
        DebugPrint "SelectGapSketchAndBodyByNameForCut: body OK """ & bodyName & """ mark=8"
    End If

    DebugPrint "SelectGapSketchAndBodyByNameForCut: selCount=" & swSelMgr.GetSelectedObjectCount2(-1)
    SelectGapSketchAndBodyByNameForCut = True
End Function

' Recorded macro FeatureCut4 for scoped multi-body: Sd=False, T1=9, T2=1, featScope=True, autoSelect=False.
Private Function FeatureCut4RecordedScoped() As SldWorks.Feature
    On Error Resume Next
    Err.Clear
    Set FeatureCut4RecordedScoped = swFeatMgr.FeatureCut4( _
        False, False, False, _
        SW_END_THROUGH_ALL_BOTH, SW_END_THROUGH_ALL, 0.01, 0.01, _
        False, False, False, False, _
        1.74532925199433E-02, 1.74532925199433E-02, _
        False, False, False, False, _
        False, _
        True, False, _
        True, True, False, _
        SW_START_SKETCH_PLANE, 0#, False, False)
    If FeatureCut4RecordedScoped Is Nothing Then
        DebugPrint "FeatureCut4RecordedScoped FAIL: " & Err.Number & " " & Err.Description
        Err.Clear
    End If
    On Error GoTo 0
End Function

