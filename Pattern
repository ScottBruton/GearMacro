Option Explicit

' FEATURE: Circular pattern of tooth gap cut.
' Paste into VBA module: Pattern
'
' Depends on Involute1: swPatternFeat, swToothCutFeat, swFeatMgr, GearGeom, GearTrain*
' Depends on Tooth: FindLastCutExtrudeFeature
' Depends on GearLib: DebugPrint, RebuildSWPart, naming/part-setup helpers

Private Sub ResolveToothCutForPattern()
    If Not swToothCutFeat Is Nothing Then Exit Sub
    Set swToothCutFeat = FindLastCutExtrudeFeature()
    If Not swToothCutFeat Is Nothing Then
        DebugPrint "ResolveToothCutForPattern: using " & swToothCutFeat.Name
        Exit Sub
    End If
    If GearTrainRoleIsDrivenOrStacked() Then Exit Sub
    Set swToothCutFeat = FindFeatureByNameSafe("Cut-Extrude1")
End Sub

Private Function FindFeatureByNameSafe(ByVal featName As String) As SldWorks.Feature
    On Error Resume Next
    Set FindFeatureByNameSafe = swPart.FeatureByName(featName)
    On Error GoTo 0
End Function

Private Function SelectForCirPatternMark(ByVal swObj As Object, ByVal mark As Long, ByVal append As Boolean) As Boolean
    Dim sd As SldWorks.SelectData
    On Error Resume Next
    Set sd = swSelMgr.CreateSelectData
    If Not sd Is Nothing Then
        sd.Mark = mark
        SelectForCirPatternMark = swObj.Select4(append, sd)
    End If
    If Not SelectForCirPatternMark Then
        SelectForCirPatternMark = swObj.Select2(append, mark)
    End If
    On Error GoTo 0
End Function

Private Function PreselectCircularPattern(ByRef stepDetail As String) As Boolean
    Dim toothName As String
    Dim axisName As String
    Dim toothOk As Boolean
    Dim axisOk As Boolean
    Dim swCylFace As SldWorks.Face2

    PreselectCircularPattern = False
    stepDetail = "clear"
    ClearSWSelection

    toothName = swToothCutFeat.Name
    axisName = gAxisName
    If axisName = "" And Not swGearAxisFeat Is Nothing Then axisName = swGearAxisFeat.Name

    stepDetail = "tooth BODYFEATURE mark4"
    toothOk = swModelDocExt.SelectByID2(toothName, "BODYFEATURE", 0, 0, 0, False, 4, Nothing, 0)
    If Not toothOk Then toothOk = SelectForCirPatternMark(swToothCutFeat, 4, False)
    If Not toothOk Then
        DebugPrint "Preselect: tooth failed for " & toothName
        Exit Function
    End If

    stepDetail = "axis mark1"
    axisOk = False
    If GearTrainRole = GEAR_ROLE_DRIVING Then
        axisOk = swModelDocExt.SelectByID2("Z Axis", "AXIS", 0, 0, 0, True, 1, Nothing, 0)
        If Not axisOk Then axisOk = swModelDocExt.SelectByID2("Z Axis", "REFAXIS", 0, 0, 0, True, 1, Nothing, 0)
        If axisOk Then DebugPrint "Preselect: pattern axis = Z Axis"
    End If
    Set swCylFace = FindAddendumCylindricalFace()
    If Not swCylFace Is Nothing Then
        axisOk = SelectForCirPatternMark(swCylFace, 1, True)
        If axisOk Then DebugPrint "Preselect: pattern axis = addendum cylindrical face"
    End If
    If Not axisOk And axisName <> "" Then
        axisOk = swModelDocExt.SelectByID2(axisName, "AXIS", 0, 0, 0, True, 1, Nothing, 0)
        If Not axisOk Then axisOk = swModelDocExt.SelectByID2(axisName, "REFAXIS", 0, 0, 0, True, 1, Nothing, 0)
        If Not axisOk Then axisOk = swModelDocExt.SelectByID2(axisName, "RefAxis", 0, 0, 0, True, 1, Nothing, 0)
        If Not axisOk Then axisOk = SelectAxisByNameWithDocSuffix(axisName)
        If axisOk Then DebugPrint "Preselect: pattern axis = ref axis " & axisName
    End If
    If Not axisOk And Not swGearAxisFeat Is Nothing Then
        axisOk = SelectForCirPatternMark(swGearAxisFeat, 1, True)
        If axisOk Then DebugPrint "Preselect: pattern axis = ref axis feature"
    End If
    If Not axisOk Then
        DebugPrint "Preselect: axis failed for " & axisName
        Exit Function
    End If

    PreselectCircularPattern = True
End Function

Private Function SelectAxisByNameWithDocSuffix(ByVal axisName As String) As Boolean
    Dim docTitle As String
    Dim fullName As String

    On Error Resume Next
    docTitle = swDoc.GetTitle
    If docTitle = "" Then Exit Function
    fullName = axisName & "@" & docTitle
    SelectAxisByNameWithDocSuffix = swModelDocExt.SelectByID2(fullName, "AXIS", 0, 0, 0, True, 1, Nothing, 0)
    If Not SelectAxisByNameWithDocSuffix Then
        SelectAxisByNameWithDocSuffix = swModelDocExt.SelectByID2(fullName, "REFAXIS", 0, 0, 0, True, 1, Nothing, 0)
    End If
    On Error GoTo 0
End Function

Private Function CreateCircularPatternFromSelection(ByRef stepDetail As String) As Boolean
    Dim swFeatData As Object
    If Not PreselectCircularPattern(stepDetail) Then Exit Function
    Set swFeatData = swFeatMgr.CreateDefinition(swFeatureNameID_e.swFmCirPattern)
    If swFeatData Is Nothing Then Exit Function
    swFeatData.BodyPattern = False
    swFeatData.GeometryPattern = False
    swFeatData.EqualSpacing = True
    swFeatData.ReverseDirection = False
    swFeatData.Spacing = 2# * Pi
    swFeatData.TotalInstances = GearGeom.NumTeeth
    swFeatData.Direction2 = False
    swFeatData.VarySketch = False
    Set swPatternFeat = swFeatMgr.CreateFeature(swFeatData)
    CreateCircularPatternFromSelection = Not (swPatternFeat Is Nothing)
End Function

Public Function CircularPatternTooth() As Boolean
    On Error GoTo PatternFail
    Dim swFeatData As Object
    Dim featArr(0) As Object
    Dim vFeatArr As Variant
    Dim stepDetail As String
    Dim toothName As String
    Dim axisName As String

    stepDetail = "resolve refs"
    ClearLastGearBuildError
    DebugPrint "CircularPatternTooth: begin z=" & GearGeom.NumTeeth
    gUseSketchCenterlineAsAxis = False
    If swGearAxisFeat Is Nothing Then
        Set swGearAxisFeat = FindRefAxisFeatureByName(BuildGearAxisFeatureName())
    End If
    If swGearAxisFeat Is Nothing And gAxisName <> "" Then
        Set swGearAxisFeat = FindRefAxisFeatureByName(gAxisName)
    End If
    If swGearAxisFeat Is Nothing And Not GearTrainRoleIsDrivenOrStacked() Then
        Set swGearAxisFeat = FindLastRefAxisFeature()
    End If
    ResolveToothCutForPattern
    If swToothCutFeat Is Nothing Then
        NoteGearBuildError "CircularPatternTooth: missing tooth gap cut for current build"
        DebugPrint gLastGearBuildError
        GoTo PatternFail
    End If
    DebugPrint "CircularPatternTooth: seed cut=" & swToothCutFeat.Name
    If GearTrainRoleIsDrivenOrStacked() Then
        RebuildSWPart
        If swGearAxisFeat Is Nothing Or gDrivenPatternUsesBossFace Then TryCreateDrivenRefAxisFromBossFace
        If swGearAxisFeat Is Nothing Then
            Set swGearAxisFeat = FindRefAxisFeatureByName(BuildGearAxisFeatureName())
        End If
        If swGearAxisFeat Is Nothing And gAxisName <> "" Then
            Set swGearAxisFeat = FindRefAxisFeatureByName(gAxisName)
        End If
        If swGearAxisFeat Is Nothing And GearTrainRole = GEAR_ROLE_STACKED And GearTrainDrivingAxisName <> "" Then
            Set swGearAxisFeat = FindRefAxisFeatureByName(GearTrainDrivingAxisName)
        End If
    End If

    If swGearAxisFeat Is Nothing And gAxisName = "" And FindAddendumCylindricalFace() Is Nothing Then
        NoteGearBuildError "CircularPatternTooth: missing ref axis and no cylindrical face on blank"
        DebugPrint gLastGearBuildError
        GoTo PatternFail
    End If

    toothName = swToothCutFeat.Name
    axisName = gAxisName
    If axisName = "" And Not swGearAxisFeat Is Nothing Then axisName = swGearAxisFeat.Name
    DebugPrint "Pattern seed=" & toothName & " axis=" & axisName & _
        IIf(gDrivenPatternUsesBossFace And axisName = "", " (cylindrical face)", "")

    stepDetail = "select BODYFEATURE+AXIS"
    DebugPrint "CircularPatternTooth: trying CreateCircularPatternFromSelection"
    If CreateCircularPatternFromSelection(stepDetail) Then GoTo PatternOk

    stepDetail = "FeatureCircularPattern4"
    DebugPrint "CircularPatternTooth: trying FeatureCircularPattern4"
    ClearSWSelection
    If PreselectCircularPattern(stepDetail) Then
        On Error Resume Next
        Set swPatternFeat = swFeatMgr.FeatureCircularPattern4(GearGeom.NumTeeth, 2# * Pi, True, "NULL", False, False, True)
        If swPatternFeat Is Nothing And gAxisName <> "" Then
            Set swPatternFeat = swFeatMgr.FeatureCircularPattern4(GearGeom.NumTeeth, 2# * Pi, True, gAxisName, False, False, True)
        End If
        On Error GoTo PatternFail
        If Not swPatternFeat Is Nothing Then GoTo PatternOk
        DebugPrint "FeatureCircularPattern4 returned Nothing after preselect"
    End If

    If Not gUseSketchCenterlineAsAxis And Not swGearAxisFeat Is Nothing Then
        stepDetail = "FeaturesToPattern+RefAxis"
        Set swFeatData = swFeatMgr.CreateDefinition(swFeatureNameID_e.swFmCirPattern)
        If Not swFeatData Is Nothing Then
            swFeatData.BodyPattern = False
            swFeatData.GeometryPattern = False
            swFeatData.EqualSpacing = True
            swFeatData.ReverseDirection = False
            swFeatData.Spacing = 2# * Pi
            swFeatData.TotalInstances = GearGeom.NumTeeth
            swFeatData.Direction2 = False
            swFeatData.VarySketch = False
            On Error Resume Next
            Set featArr(0) = swToothCutFeat
            vFeatArr = featArr
            swFeatData.FeaturesToPattern = vFeatArr
            Set swFeatData.Axis = swGearAxisFeat
            Set swPatternFeat = swFeatMgr.CreateFeature(swFeatData)
            If Err.Number <> 0 Then
                DebugPrint "FeaturesToPattern+RefAxis err: " & Err.Number & " " & Err.Description
                Err.Clear
            End If
            On Error GoTo PatternFail
            If Not swPatternFeat Is Nothing Then GoTo PatternOk
        End If
    End If

    stepDetail = "axis edge"
    ClearSWSelection
    If Not gUseSketchCenterlineAsAxis Then
        If swModelDocExt.SelectByID2(toothName, "BODYFEATURE", 0, 0, 0, False, 4, Nothing, 0) Then
            If swModelDocExt.SelectByID2(axisName, "EDGE", 0, 0, 0, True, 1, Nothing, 0) Then
                Set swFeatData = swFeatMgr.CreateDefinition(swFeatureNameID_e.swFmCirPattern)
                If Not swFeatData Is Nothing Then
                    swFeatData.BodyPattern = False
                    swFeatData.EqualSpacing = True
                    swFeatData.Spacing = 2# * Pi
                    swFeatData.TotalInstances = GearGeom.NumTeeth
                    Set swPatternFeat = swFeatMgr.CreateFeature(swFeatData)
                    If Not swPatternFeat Is Nothing Then GoTo PatternOk
                End If
            End If
        End If
    End If

    If Not gUseSketchCenterlineAsAxis Then
        stepDetail = "FeaturesToPattern property"
        Set swFeatData = swFeatMgr.CreateDefinition(swFeatureNameID_e.swFmCirPattern)
        If Not swFeatData Is Nothing Then
            swFeatData.BodyPattern = False
            swFeatData.GeometryPattern = False
            swFeatData.EqualSpacing = True
            swFeatData.ReverseDirection = False
            swFeatData.Spacing = 2# * Pi
            swFeatData.TotalInstances = GearGeom.NumTeeth
            swFeatData.Direction2 = False
            swFeatData.VarySketch = False
            On Error Resume Next
            Set featArr(0) = swToothCutFeat
            vFeatArr = featArr
            swFeatData.FeaturesToPattern = vFeatArr
            Set swFeatData.Axis = swGearAxisFeat
            Set swPatternFeat = swFeatMgr.CreateFeature(swFeatData)
            On Error GoTo PatternFail
            If Not swPatternFeat Is Nothing Then GoTo PatternOk
            DebugPrint "FeaturesToPattern CreateFeature failed: " & Err.Number & " " & Err.Description
            Err.Clear
        End If
    End If

    GoTo PatternFail

PatternOk:
    ClearSWSelection
    RebuildSWPart
    DebugPrint "CircularPatternTooth OK (instances=" & GearGeom.NumTeeth & ", " & swPatternFeat.Name & ")"
    CircularPatternTooth = True
    Exit Function

PatternFail:
    NoteGearBuildError FormatVBError("CircularPatternTooth at " & stepDetail)
    If gLastGearBuildError = "" Then NoteGearBuildError "CircularPatternTooth failed at " & stepDetail
    DebugPrint "CircularPatternTooth FAIL (" & stepDetail & "): " & gLastGearBuildError
    CircularPatternTooth = False
End Function
