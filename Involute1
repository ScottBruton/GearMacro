    ModuleMM As Double
    NumTeeth As Long
    WidthMM As Double
    PitchDiameterMM As Double
    PitchRadiusMM As Double
    BaseDiameterMM As Double
    BaseRadiusMM As Double
    AddendumDiameterMM As Double
    AddendumRadiusMM As Double
    DedendumDiameterMM As Double
    DedendumRadiusMM As Double
    CircularPitchMM As Double
    AngularPitchDeg As Double
    PitchRadiusM As Double
    BaseRadiusM As Double
    AddendumRadiusM As Double
    DedendumRadiusM As Double
    WidthM As Double
    HubDiameterMM As Double
    HubRadiusMM As Double
    UseHub As Boolean
    ShaftDiameterMM As Double
    ShaftRadiusMM As Double
    RimWidthMM As Double
    HubWidthMM As Double
    RimWidthM As Double
    HubWidthM As Double
    HubRadiusM As Double
    ShaftRadiusM As Double
    GapArcLengthMM As Double
    GapHalfArcLengthMM As Double
    GapRootFilletMM As Double
    IsInternal As Boolean
End Type

Public GearGeom As GearGeometry
