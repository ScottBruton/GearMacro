Public swLayoutSketchFeat As SldWorks.Feature
Public swLayoutCenterPt As SldWorks.SketchPoint
Public swRevolveAxisSketchFeat As SldWorks.Feature
Public swRevolveProfileSketchFeat As SldWorks.Feature
Public swRevolveFeat As SldWorks.Feature
