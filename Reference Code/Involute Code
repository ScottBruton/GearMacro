Sub main()
    Set swApp = Application.SldWorks
    Set swDoc = swApp.NewPart
    Set swPart = swDoc
    Set swModelDocExt = swDoc.Extension
    swModelDocExt.SetUserPreferenceInteger swUserPreferenceIntegerValue_e.swUnitsLinear, _
                            swUserPreferenceOption_e.swDetailingNoOptionSpecified, swMM
    swModelDocExt.SetUserPreferenceInteger swUserPreferenceIntegerValue_e.swUnitsLinearDecimalPlaces, _
                            swUserPreferenceOption_e.swDetailingNoOptionSpecified, 6
    swModelDocExt.SetUserPreferenceInteger swUserPreferenceIntegerValue_e.swUnitsAngularDecimalPlaces, _
                            swUserPreferenceOption_e.swDetailingNoOptionSpecified, 6
    Pi = 3.14159265358979
    swApp.SetUserPreferenceIntegerValue swUserPreferenceIntegerValue_e.swShowEquationPotentialCircularReferencesMessage, 2
    Set ConfigMgr = swDoc.ConfigurationManager
    Set swSketchManager = swPart.SketchManager
    Set swFeatMgr = swDoc.FeatureManager
    Set swSelMgr = swDoc.SelectionManager
    Set swEquationMgr = swPart.GetEquationMgr
    
    swEquationMgr.AutomaticRebuild = True
    swEquationMgr.AngularEquationUnits = swAngularEquationUnitsDegrees
    swPart.EditRebuild
    
    PopulateEquations
    Planes
    swSketchManager.AutoSolve = False
    swSketchManager.AddToDB = True
    Set swSelData = swSelMgr.CreateSelectData
    
    '#######################################################################
    Involuti
    AnglePLine
    CuttingSketch
    FirstBodySketch
    HalfPitchBase
    Tipfillet
    Rootfillet
    Mirror
    Pattern
    DedendumBody
    
    '#######################################################################
    

    swPart.ViewZoomtofit2
    swPart.ClearSelection
    swPart.EditRebuild3
    
    
    
End Sub



