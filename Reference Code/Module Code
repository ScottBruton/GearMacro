Sub HalfPitchBase(Optional DummyArg As String)
    
    swSketchManager.AutoSolve = True
    swSketchManager.AddToDB = False

    RefPlaneFt(1).Select True
    swSketchManager.InsertSketch True
    Set sw2DSketch = swSketchManager.ActiveSketch
    
    'Quarter pitch Angle in degrees
    QPA = 360 / (4 * z)
    'Quarter pitch Angle in radians
    QPAradians = QPA * Pi / 180
    Dd = Dp - 2.5 * m
    Set OutCircleArc = swSketchManager.CreateCircleByRadius(0, 0, 0, Dd / 2000)
    'Set OutCircleArc = swSketchManager.CreateArc(0, 0, 0, 0, Dd / 2000, 0, -(Dd / 2000) * Sin(QPAradians), (Dd / 2000) * Cos(QPAradians), 0, 1)
