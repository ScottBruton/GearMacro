    'Connect end point Line to Dd Circle
    swPt.Select4 False, swSelData
    OutCircleArc.Select4 True, swSelData
    swPart.SketchAddConstraints "sgCOINCIDENT"
    
    Set swSketchLine = VLineQP
    Set swPt = swSketchLine.GetEndPoint2
    swPt.Select4 False, swSelData
    OutCircleArc.Select4 True, swSelData
    swPart.SketchAddConstraints "sgCOINCIDENT"

    'Trim
    OutCircleArc.Select4 True, swSelData
    swSketchManager.SketchTrim swSketchTrimClosest, Da * Cos(Pi / 4) / 2000, -Da * Cos(Pi / 4) / 2000, 0
    
    'Add point Dd for later selection edge coordinates
    
    Set swDdPt = swSketchManager.CreatePoint(-(Dd / 2000) * Sin(QPAradians / 4), (Dd / 2000) * Cos(QPAradians / 4), 0)
