    PeqStrg = PeqStrg & "=""Dd"""
    Set swEquationMgr = swPart.GetEquationMgr
    swEquationMgr.Add3 e, PeqStrg, True, swAllConfiguration, Empty
    e = e + 1
    
    Set VLineQP = swSketchManager.CreateLine(0, 0, 0, (Dd / 2000) * Sin(QPAradians), (Dd / 2000) * Cos(QPAradians), 0)
    RefPlaneFt(4).Select True
    swPart.SketchAddConstraints "sgCOLINEAR"

    Set ALineQP = swSketchManager.CreateLine(0, 0, 0, -(Dd / 2000) * Sin(QPAradians), (Dd / 2000) * Cos(QPAradians), 0)
   
    'Place dimension angle ALineQP vs Right Plane
    Set swSketchLine = ALineQP
    Set swPt = swSketchLine.GetEndPoint2

    ALineQP.Select4 False, swSelData
    RefPlaneFt(3).Select2 True, 1
    
    Set dispDim = swDoc.AddDimension2(swPt.X / 2, swPt.Y, 0)
    AngleDim = dispDim.GetNameForSelection
    
