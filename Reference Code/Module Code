    swPart.SketchAddConstraints "sgCOINCIDENT"
    swPart.ClearSelection2 True
    
    swDdPt.Select4 False, swSelData
    boolstatus = swPart.Extension.SelectByID2("Arc1", "SKETCHSEGMENT", -3.01313034679196E-03, 6.01603416424543E-03, 3.41634848231787E-02, True, 0, Nothing, 0)
    swPart.SketchAddConstraints "sgCOINCIDENT"
    swPart.ClearSelection2 True

    'Add point Da for later selection edge coordinates
    Set swDaPt = swPart.SketchManager.CreatePoint(0, Da / 1500, 0#)
    swPart.SetPickMode
    swPart.ClearSelection2 True
    swDaPt.Select4 False, swSelData
