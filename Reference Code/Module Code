Public Sub PopulateEquations(Optional DummyArg As String)
    a = InputBox("Pressure Angle a° = ", , 20)
    m = InputBox("Module m[mm] = ", , 1.25)
    z = InputBox("Number of Teeth z = ", , 9)
    w = InputBox("Width W[mm] = ", , 10)
    
    Set swActConfig = ConfigMgr.ActiveConfiguration
    ReDim swConfig(1 To 2)
    Set swConfig(2) = ConfigMgr.AddConfiguration("Module = " & m & " x Teeth = " & z, "", "", 1, "", "")
    
    Set swEquationMgr = swPart.GetEquationMgr
    If swEquationMgr Is Nothing Then
        MsgBox "Nothing"
    End If
    
    e = 0
    longstatus = swEquationMgr.Add3(e, """a""=" & a, True, swAllConfiguration, swConfig(2).Name)
    e = e + 1
    
    swEquationMgr.Add3 e, """m""=" & m, True, swAllConfiguration, swConfig(2).Name
    e = e + 1
    
    swEquationMgr.Add3 e, """z""=" & z, True, swAllConfiguration, swConfig(2).Name
    e = e + 1
    
    swEquationMgr.Add3 e, """w""=" & w, True, swAllConfiguration, swConfig(2).Name
    e = e + 1
    
    swEquationMgr.Add3 e, """Dp""= ""m"" * ""z""", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """Db""=""Dp"" *cos(""a"")", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """rb""=""Db"" / 2 ", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """Da""= ""Dp"" + 2*""m""", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """Dd""= ""Dp"" - 2.5*""m""", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """QPA""= 180 - (360 / (""z"" * 4))", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """cQPA""= (360 / (""z"" * 4))", True, swAllConfiguration, Empty
    e = e + 1
    
    swEquationMgr.Add3 e, """Ft""= ""m"" * .25", True, swAllConfiguration, Empty
    e = e + 1
    
    swPart.EditRebuild

End Sub
Sub Planes(Optional DummyArg As String)

    ' Select the Ref planeS & added to RefPlaneFt() & RefPlaneName()
    ReDim RefPlaneFt(1 To 5) As SldWorks.Feature
    ReDim RefPlaneName(1 To 5) As String
    ftsVar = swFeatMgr.GetFeatures(True)
    Dim j As Integer
    j = 0
    For Each ftVar In ftsVar
        Set swFeat = ftVar
        If swFeat.GetTypeName2 = "RefPlane" Then
            j = j + 1
            RefPlaneName(j) = swFeat.Description
            Set swRefPlaneFtData = swFeat.GetDefinition
            Set RefPlaneFt(j) = swFeat
            If j = 3 Then
                Exit For
            End If
        End If
    Next
    
    swPart.ClearSelection
    
    'Create Axis
    RefPlaneFt(1).Select True
    boolstatus = swModelDocExt.SelectByID2("Point1@Origin", "EXTSKETCHPOINT", 0, 0, 0, True, 0, Nothing, 0)
    boolstatus = swDoc.InsertAxis2(True)
    Set RefPlaneFt(5) = swSelMgr.GetSelectedObject5(1)
    RefPlaneName(5) = RefPlaneFt(5).Name

    swDoc.ClearSelection2 True
    swModelDocExt.Rebuild True

End Sub
