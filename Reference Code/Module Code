Sub AnglePLine(Optional DummyArg As String)
    'Pline would be at intersection of Dp with the Involute
    RefPlaneFt(1).Select True
    swSketchManager.InsertSketch True
    Set sw2DSketch = swSketchManager.ActiveSketch
    Set PLine = swSketchManager.CreateLine(0, 0, 0, 0, (Dp / 2000), 0)
