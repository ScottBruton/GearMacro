Private Sub UpdateGearRoleUI()
    Dim showDrivenLayout As Boolean
    Dim showBaseGearPicker As Boolean
    On Error Resume Next

    showDrivenLayout = GetOptionValue("optDrivenGear")
    showBaseGearPicker = showDrivenLayout Or GetOptionValue("optStackedGear") Or (GearTrainRole = GEAR_ROLE_STACKED)

    ' Frame must stay visible for Stacked when picker controls live inside fraDrivenGear (child Visible is ignored if parent is hidden)
    SetFormControlVisible "fraDrivenGear", showBaseGearPicker
    SetFormControlVisible "lblDrivingGear", showBaseGearPicker
    SetFormControlVisible "cboDrivingGearBody", showBaseGearPicker
    SetFormControlVisible "tbDrivingGearBody", showBaseGearPicker
    SetFormControlVisible "btnPickDrivingBody", showBaseGearPicker
    SetFormControlVisible "btnRefreshDrivingGear", showBaseGearPicker
    SetFormControlVisible "lblMeshAngle", showDrivenLayout
    SetFormControlVisible "tbMeshAngle", showDrivenLayout
    SetFormControlVisible "lblTrainCenter", showDrivenLayout
    SetFormControlVisible "tbTrainCenter", showDrivenLayout
    SetFormControlVisible "fraManufacturing", showDrivenLayout
    SetFormControlVisible "tbTrainCenterAdjusted", showDrivenLayout
    SetFormControlVisible "tbCenterClearance", showDrivenLayout
    SetFormControlVisible "tbBacklash", showDrivenLayout
    SetFormControlVisible "TextBox1", showDrivenLayout
    SetFormControlVisible "TextBox2", showDrivenLayout
    SetFormControlVisible "TextBox3", showDrivenLayout
    SetFormControlVisible "cboMfgMethods", showDrivenLayout
    SetFormControlVisible "cboMfgMethod", showDrivenLayout

    If showBaseGearPicker Then
        tbModule.Enabled = False
        tbPressureAngle.Enabled = False
        tbModule.BackColor = RGB(240, 240, 240)
        tbPressureAngle.BackColor = RGB(240, 240, 240)
        RefreshDrivingGearBodyCombo
        UpdateDrivingGearDisplay
        If showDrivenLayout Then
            ApplyMfgMethodDefaults
            UpdateTrainCenterDistance
        End If
    Else
        tbModule.Enabled = True
        tbPressureAngle.Enabled = True
        tbModule.BackColor = vbWhite
        tbPressureAngle.BackColor = vbWhite
    End If
    On Error GoTo 0
End Sub

Private Function GetDrivingGearBodyCombo() As Object
