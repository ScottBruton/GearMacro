' UserForm1 Code Module
' Copy into the UserForm1 code module in your VBA project.
'
' FORM SHOW MODE: main() uses Show vbModeless + DoEvents loop until form closes (required for SW body pick).
' SW UserForms have no ShowModal property — modeless is only vbModeless in code.
'
' ADD THESE CONTROLS IN THE VBA FORM DESIGNER (names must match):
'   optDrivingGear   OptionButton  Caption "Driving gear"   GroupName = "GearRole"
'   optDrivenGear    OptionButton  Caption "Driven gear"    GroupName = "GearRole"
'   optStackedGear   OptionButton  Caption "Stacked"        GroupName = "GearRole"
'   fraDrivenGear    Frame         Caption "Driven gear layout" (stays visible for Stacked too if picker controls are inside it)
'   lblDrivingGear   Label         Caption "Driving gear:"
'   btnCancel / cbCancel / btnClose — call CloseGearForm (ends main() DoEvents loop)
'   cboDrivingGearBody ComboBox    Style=2 — macro gears from all open parts
'                                  Bodies named ""teethT pitchDia"" (e.g. 9T 11.25); matching ref axis ""9T 11.25 Axis""
'   tbDrivingGearBody TextBox      Optional summary; Locked=True
'   btnRefreshDrivingGear CommandButton Caption "Refresh list" (or keep btnPickDrivingBody name)
'   lblMeshAngle     Label         Caption "Mesh angle (deg, 0=inline with driving gear):"
'   tbMeshAngle      TextBox       default "0"
'   lblTrainCenter   Label         Caption "Centre distance:"
'   tbTrainCenter    TextBox       Locked=True (read-only, shows C = m(z1+z2)/2)
'   fraManufacturing Frame
'   cboMfgMethod / cboMfgMethods  ComboBox Style=2 — items filled in code
'   tbCenterClearance OR TextBox1 (in fraManufacturing) = centre clearance added to C (mm)
'   tbBacklash OR TextBox2 = backlash at pitch circle (mm), added to layout C
'   tbTrainCenterAdjusted OR TextBox3 = read-only adjusted centre distance (mm)
'
'   optExternalGear   OptionButton  Caption "External"   GroupName = "GearType"
'   optInternalGear    OptionButton  Caption "Internal (ring)"   GroupName = "GearType"
'
'   tbHubDia         TextBox       Optional hub OD (mm); blank = 40% of pitch diameter
'   tbShaftDia       TextBox       Optional bore/shaft dia (mm); blank = 10 mm
'   optInvoluteFlank CheckBox      Optional: true involute gap flank (CreateEquationSpline2) instead of PA arc
'

Private Sub UserForm_Initialize()
    On Error Resume Next
    tbPressureAngle.Text = "20"
    tbModule.Text = "1.25"
    tbTeeth.Text = "100"
    tbWidth.Text = "10"
    If ControlExists("tbHubDia") Then tbHubDia.Text = ""
    If ControlExists("tbShaftDia") Then tbShaftDia.Text = ""

    If ControlExists("optDrivingGear") Then optDrivingGear.Value = True
    If ControlExists("optExternalGear") Then optExternalGear.Value = True
    If ControlExists("optInvoluteFlank") Then optInvoluteFlank.Value = False
    If ControlExists("tbMeshAngle") Then tbMeshAngle.Text = "0"
    SyncGearTypeFromForm

    InitMfgMethodCombo
    InitMfgControlTooltips

    UpdateGearRoleUI
    On Error GoTo 0

    On Error Resume Next
    ValidateInputs
    UpdateGearCalculations
    On Error GoTo 0
End Sub

Private Function ControlExists(ByVal ctrlName As String) As Boolean
    ControlExists = Not (FindControlByName(Me, ctrlName) Is Nothing)
End Function

Private Function GetOptionValue(ByVal ctrlName As String) As Boolean
    Dim ctrl As Object
    GetOptionValue = False
    Set ctrl = FindControlByName(Me, ctrlName)
    If ctrl Is Nothing Then Exit Function
    On Error Resume Next
    GetOptionValue = ctrl.Value
    On Error GoTo 0
End Function

Private Sub SyncGearTypeFromForm()
