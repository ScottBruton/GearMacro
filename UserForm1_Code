End Sub

Private Function AllComboBoxesOnForm(ByVal parent As Object) As Collection
    Dim result As New Collection
    Dim c As Object
    Dim subC As Object
    For Each c In parent.Controls
        If TypeName(c) = "ComboBox" Then result.Add c
        If TypeName(c) = "Frame" Then
            For Each subC In AllComboBoxesOnForm(c)
                result.Add subC
            Next subC
        End If
    Next c
    Set AllComboBoxesOnForm = result
End Function

Private Sub InitMfgMethodCombo()
    Dim cb As Object
    On Error Resume Next
    Set cb = GetMfgMethodCombo()
    If cb Is Nothing Then Exit Sub
    If cb.ListCount > 0 Then Exit Sub
    With cb
        .Clear
        .Style = 2
        .AddItem "Nominal (CAD)"
        .AddItem "3D print"
        .AddItem "CNC"
        .AddItem "OTS (catalog)"
        .ListIndex = 0
    End With
    ApplyMfgMethodDefaults
    On Error GoTo 0
End Sub

Private Sub UserForm_Activate()
    InitMfgMethodCombo
    On Error Resume Next
    If GetOptionValue("optDrivenGear") Then RefreshDrivingGearBodyCombo
    On Error GoTo 0
End Sub

Private Sub ApplyMfgMethodDefaults()
    Dim cb As Object
    Dim clr As String
    Dim bl As String

    On Error Resume Next
    Set cb = GetMfgMethodCombo()
    If cb Is Nothing Then Exit Sub

    Select Case cb.ListIndex
        Case 1          ' 3D print
            clr = "0.15"
            bl = "0.10"
        Case 2          ' CNC
            clr = "0.03"
            bl = "0"
        Case Else       ' Nominal (CAD), OTS (catalog)
            clr = "0"
            bl = "0"
    End Select

    SetMfgTextBox GetMfgClearanceTextBox(), clr
    SetMfgTextBox GetMfgBacklashTextBox(), bl
    UpdateTrainCenterDistance
    On Error GoTo 0
End Sub

Private Sub InitMfgControlTooltips()
    Dim tipMethod As String
    Dim tipClr As String
    Dim tipBl As String
    Dim tipAdj As String

    tipMethod = "Preset centre clearance and backlash for the selected process. Values fill automatically; you can edit them."
    tipClr = "Extra centre distance added to the nominal value (mm). Covers assembly clearance, print shrink, and housing tolerance. Added when placing the driven gear."
    tipBl = "Backlash: circumferential gap between mating teeth at the pitch circle (mm). Prevents binding as teeth mesh; larger for 3D print, smaller for CNC. This value is added to centre distance for driven-gear layout."
    tipAdj = "Centre distance used for driven gear placement = nominal + clearance + backlash (mm). Updates when you change method, teeth, or the values above."

    SetControlTipOnObject GetMfgMethodCombo(), tipMethod
    SetControlTipOnObject GetMfgClearanceTextBox(), tipClr
    SetControlTipOnObject GetMfgBacklashTextBox(), tipBl
    SetControlTipOnObject GetMfgAdjustedCenterTextBox(), tipAdj

    SetControlTip "cboMfgMethods", tipMethod, "fraManufacturing"
    SetControlTip "cboMfgMethod", tipMethod, "fraManufacturing"
    SetControlTip "tbCenterClearance", tipClr, "fraManufacturing"
    SetControlTip "TextBox1", tipClr, "fraManufacturing"
    SetControlTip "tbBacklash", tipBl, "fraManufacturing"
    SetControlTip "TextBox2", tipBl, "fraManufacturing"
    SetControlTip "tbTrainCenterAdjusted", tipAdj, "fraManufacturing"
    SetControlTip "TextBox3", tipAdj, "fraManufacturing"
End Sub

