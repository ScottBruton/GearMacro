Private Sub SetControlTip(ByVal ctrlName As String, ByVal tip As String, Optional ByVal searchInFrame As String = "")
    Dim parent As Object
    Dim ctrl As Object
    Set parent = Me
    If searchInFrame <> "" Then Set parent = FindControlByName(Me, searchInFrame)
    If parent Is Nothing Then Set parent = Me
    Set ctrl = FindControlByName(parent, ctrlName)
    If ctrl Is Nothing Then Exit Sub
    On Error Resume Next
    ctrl.ControlTipText = tip
    On Error GoTo 0
End Sub

Private Sub SetControlTipOnObject(ByVal ctrl As Object, ByVal tip As String)
